{
  "version": "1.0.0",
  "application": {
    "name": "Application Form Management System",
    "description": "Universal application and data collection form",
    "status": "active",
    "submissionEndpoint": "/api/applications",
    "healthEndpoint": "/api/health"
  },

  "form": {
    "id": "universal-application-form",
    "title": "Application Form",
    "description": "Please provide accurate information and upload the required documents.",
    "submitButtonText": "Submit Application",
    "successMessage": "Application submitted successfully.",
    "errorMessage": "Unable to submit the application. Please try again."
  },

  "sections": [
    {
      "id": "personal",
      "title": "Basic Information",
      "fields": [
        {
          "id": "fullName",
          "name": "fullName",
          "label": "Full Name",
          "type": "text",
          "required": true,
          "autocomplete": "name",
          "placeholder": "Enter your full name"
        },
        {
          "id": "email",
          "name": "email",
          "label": "Email Address",
          "type": "email",
          "required": true,
          "autocomplete": "email",
          "placeholder": "Enter your email address"
        },
        {
          "id": "phone",
          "name": "phone",
          "label": "Phone Number",
          "type": "tel",
          "required": true,
          "autocomplete": "tel",
          "placeholder": "Enter your phone number"
        },
        {
          "id": "dateOfBirth",
          "name": "dateOfBirth",
          "label": "Date of Birth",
          "type": "date",
          "required": false
        },
        {
          "id": "gender",
          "name": "gender",
          "label": "Gender",
          "type": "select",
          "required": false,
          "options": [
            {
              "value": "",
              "label": "Select"
            },
            {
              "value": "male",
              "label": "Male"
            },
            {
              "value": "female",
              "label": "Female"
            },
            {
              "value": "other",
              "label": "Other"
            },
            {
              "value": "prefer_not_to_say",
              "label": "Prefer not to say"
            }
          ]
        }
      ]
    },

    {
      "id": "address",
      "title": "Address Information",
      "fields": [
        {
          "id": "addressLine1",
          "name": "addressLine1",
          "label": "Address",
          "type": "text",
          "required": true,
          "autocomplete": "street-address",
          "placeholder": "House / Street / Locality"
        },
        {
          "id": "city",
          "name": "city",
          "label": "City",
          "type": "text",
          "required": true,
          "autocomplete": "address-level2",
          "placeholder": "Enter city"
        },
        {
          "id": "state",
          "name": "state",
          "label": "State / Province",
          "type": "text",
          "required": true,
          "autocomplete": "address-level1",
          "placeholder": "Enter state"
        },
        {
          "id": "postalCode",
          "name": "postalCode",
          "label": "Postal Code",
          "type": "text",
          "required": true,
          "autocomplete": "postal-code",
          "placeholder": "Enter postal code"
        },
        {
          "id": "country",
          "name": "country",
          "label": "Country",
          "type": "text",
          "required": true,
          "autocomplete": "country",
          "placeholder": "Enter country"
        }
      ]
    },

    {
      "id": "additional",
      "title": "Additional Information",
      "fields": [
        {
          "id": "occupation",
          "name": "occupation",
          "label": "Occupation",
          "type": "text",
          "required": false,
          "placeholder": "Enter occupation"
        },
        {
          "id": "organization",
          "name": "organization",
          "label": "Organization / Company",
          "type": "text",
          "required": false,
          "placeholder": "Enter organization name"
        },
        {
          "id": "reference",
          "name": "reference",
          "label": "Reference",
          "type": "text",
          "required": false,
          "placeholder": "Reference, if applicable"
        },
        {
          "id": "remarks",
          "name": "remarks",
          "label": "Additional Remarks",
          "type": "textarea",
          "required": false,
          "placeholder": "Enter any additional information"
        }
      ]
    }
  ],

  "uploads": {
    "endpoint": "/api/applications",
    "method": "POST",
    "multipart": true,
    "maximumFileSizeMB": 10,
    "maximumTotalFiles": 20,

    "fields": [
      {
        "name": "photo",
        "label": "Photo",
        "category": "photo",
        "multiple": false,
        "required": false,
        "acceptedTypes": [
          "image/jpeg",
          "image/png",
          "image/webp"
        ]
      },
      {
        "name": "resume",
        "label": "Resume",
        "category": "resume",
        "multiple": false,
        "required": false,
        "acceptedTypes": [
          "application/pdf",
          "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        ]
      },
      {
        "name": "documents",
        "label": "Documents",
        "category": "document",
        "multiple": true,
        "required": false,
        "maximumFiles": 15,
        "acceptedTypes": [
          "image/jpeg",
          "image/png",
          "image/webp",
          "application/pdf",
          "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        ]
      }
    ]
  },

  "authorization": {
    "enabled": true,
    "type": "wrt",
    "informationEndpoint": "/api/access/{requestId}",
    "approveEndpoint": "/api/access/{requestId}/approve",
    "denyEndpoint": "/api/access/{requestId}/deny",
    "requestValidityMinutes": 30
  },

  "submission": {
    "endpoint": "/api/applications",
    "method": "POST",
    "contentType": "multipart/form-data",
    "applicationDataField": "data",
    "expectedSuccessStatus": 201,

    "response": {
      "applicationId": "applicationId",
      "databaseId": "id",
      "status": "status",
      "files": "files"
    }
  },

  "validation": {
    "fullName": {
      "minLength": 2,
      "maxLength": 100
    },
    "email": {
      "maxLength": 150
    },
    "phone": {
      "minLength": 7,
      "maxLength": 20
    },
    "postalCode": {
      "minLength": 3,
      "maxLength": 12
    },
    "remarks": {
      "maxLength": 3000
    }
  },

  "applicationStatuses": [
    "Submitted",
    "Under Review",
    "Documents Required",
    "Verified",
    "Approved",
    "Rejected",
    "Withdrawn"
  ],

  "api": {
    "health": "/api/health",

    "public": {
      "submitApplication": "/api/applications",
      "accessInformation": "/api/access/{requestId}",
      "approveAccess": "/api/access/{requestId}/approve",
      "denyAccess": "/api/access/{requestId}/deny"
    },

    "admin": {
      "login": "/api/admin/login",
      "logout": "/api/admin/logout",
      "applications": "/api/admin/applications",
      "application": "/api/admin/applications/{id}",
      "files": "/api/admin/applications/{id}/files",
      "file": "/api/admin/files/{fileId}",
      "pdf": "/api/admin/applications/{id}/pdf",
      "status": "/api/admin/applications/{id}/status",
      "accessRequest": "/api/admin/applications/{id}/access-request",
      "accessStatus": "/api/admin/applications/{id}/access-status",
      "approveAccess": "/api/admin/access-requests/{requestId}/approve",
      "denyAccess": "/api/admin/access-requests/{requestId}/deny",
      "auditLogs": "/api/admin/audit-logs",
      "aiAnalysis": "/api/admin/ai/analyze"
    }
  },

  "storage": {
    "localStorage": {
      "formDraftKey": "application_form_draft",
      "applicationIdKey": "application_id",
      "submissionKey": "application_submission"
    }
  },

  "messages": {
    "loading": "Submitting application...",
    "success": "Application submitted successfully.",
    "submissionFailed": "Application submission failed.",
    "networkError": "Unable to connect to the server.",
    "validationError": "Please check the highlighted fields.",
    "fileTypeError": "Unsupported file type.",
    "fileSizeError": "File exceeds the 10 MB limit.",
    "authorizationRequired": "Authorization is required before continuing."
  }
}
