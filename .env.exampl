# =========================================================
# APPLICATION FORM MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================
#
# IMPORTANT:
# This file is a template only.
# Never place real passwords, tokens, API keys,
# database credentials, or production secrets here.
#
# Copy these variables into your deployment environment.
# =========================================================


# ---------------------------------------------------------
# SERVER
# ---------------------------------------------------------

NODE_ENV=development

PORT=10000


# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------

# PostgreSQL connection string.
#
# Example:
# DATABASE_URL=postgresql://username:password@hostname:5432/database
#
# Do NOT put a real production database URL in this file.

DATABASE_URL=


# ---------------------------------------------------------
# ADMIN AUTHENTICATION
# ---------------------------------------------------------

# Secret administrator access token.
#
# Generate a long random value for production.
#
# Example:
# ADMIN_TOKEN=

ADMIN_TOKEN=


# ---------------------------------------------------------
# SESSION / JWT SECURITY
# ---------------------------------------------------------

# Secret used to sign administrator JWT sessions.
#
# Use a long random secret in production.
#
# Example:
# SESSION_SECRET=

SESSION_SECRET=


# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------

# Comma-separated list of trusted frontend origins.
#
# Development example:
# ALLOWED_ORIGINS=http://localhost:10000
#
# Production example:
# ALLOWED_ORIGINS=https://your-domain.example

ALLOWED_ORIGINS=


# ---------------------------------------------------------
# AI API
# ---------------------------------------------------------

# Optional AI provider configuration.
#
# Leave AI_API_KEY empty if AI analysis is not being used.

AI_API_KEY=

AI_API_URL=https://api.openai.com/v1/chat/completions

AI_MODEL=gpt-4o-mini


# ---------------------------------------------------------
# OPTIONAL APPLICATION SETTINGS
# ---------------------------------------------------------

# Maximum uploaded file size in MB.
# The current server implementation uses 10 MB.

MAX_FILE_SIZE_MB=10

# Access-request lifetime in minutes.
# The current server implementation uses 30 minutes.

ACCESS_REQUEST_EXPIRY_MINUTES=30
